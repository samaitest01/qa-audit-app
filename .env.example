# Copy this file to .env.local for local development, and set the same
# values as Environment Variables in Vercel for production.

# From your Supabase project: Project Settings -> API -> Legacy anon, service_role API keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Used only to sign login sessions — any long random string, doesn't need
# to be memorable or typed in by anyone. Set it once and forget it.
SESSION_SECRET=replace-with-a-long-random-string

# NOTE: there is no SITE_PASSWORD here anymore — the app's login password
# is now set from inside the app itself, the first time anyone opens it.
