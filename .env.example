# Copy this file to .env.local for local development, and set the same
# two values as Environment Variables in Vercel for production.
#
# Both come from your Supabase project: Project Settings -> API.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Shared password gate — protects the whole app behind one team password.
# SITE_PASSWORD: whatever password your team will type in to get in.
# SESSION_SECRET: any long random string (used only to sign the login
# session — doesn't need to be memorable, just unique and private).
SITE_PASSWORD=choose-a-team-password
SESSION_SECRET=replace-with-a-long-random-string
